PROGRAM Automatic_Controls
#info= QLD
BOF


(*Controls fan speed based on how many bays are active;*)

SOR  [0,1] (**) (**)  FB  [1,0] (*SCALER*) (*SCALER_4*) ( (*EN:EN*)(**) (**)  , (*Input:*)(*VAR_Active_Bay_Count*) (**)  , (*InputMin:*)(*0.0*) (**)  , (*InputMax:*)(*3.0*) (**)  , (*OutputMin:*)(*0.0*) (**)  , (*OutputMax:*)(*65535.0*) (**) ; (*ENO:ENO*)(**) (**)  , (*Output:*)(*VAR_Scaled_Hz_To_Eng_Units*) (**) )  FB  [4,0] (*1 gain*) (*9*) ( (*EN:EN*)(**) (**)  , (*i1:*)(*VAR_Scaled_Hz_To_Eng_Units*) (**) ; (*ENO:ENO*)(**) (**)  , (*o1:*)(*AO_Supply_Fan_Speed_Cmd*) (**) )  FB  [7,0] (*1 gain*) (*10*) ( (*EN:EN*)(**) (**)  , (*i1:*)(*VAR_Scaled_Hz_To_Eng_Units*) (**) ; (*ENO:ENO*)(**) (**)  , (*o1:*)(*AO_Exhaust_Fan_Speed_Cmd*) (**) )
EOR [10,0]


(**)

SOR  [0,8] (**) (**)  FB  [1,0] (*DynamicPressureTrim*) (*SupplyPressureTrim*) ( (*EN:EN*)(**) (**)  , (*VAR_Plenum_Pressure:*)(*AI_Supply_Pressure_PV*) (**)  , (*VAR_FanSpeed_Cmd:*)(*AO_Supply_Fan_Speed_Cmd*) (**)  , (*CFG_Pressure_SP:*)(*CFG_Supply_Pressure_SP*) (**) ; (*ENO:ENO*)(**) (**) )  FB  [4,0] (*DynamicPressureTrim*) (*ExhaustPressureTrim*) ( (*EN:EN*)(**) (**)  , (*VAR_Plenum_Pressure:*)(*AI_Exhaust_Pressure_PV*) (**)  , (*VAR_FanSpeed_Cmd:*)(*AO_Exhaust_Fan_Speed_Cmd*) (**)  , (*CFG_Pressure_SP:*)(*CFG_Exhaust_Pressure_SP*) (**) ; (*ENO:ENO*)(**) (**) )
EOR [7,0]
EOF
#end_info
#info= ID_MAX
NextId=12
#end_info
END_PROGRAM