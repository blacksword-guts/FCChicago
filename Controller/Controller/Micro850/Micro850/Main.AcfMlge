      <Text>If AUTO_BURNER_CMD and conditions are met for BURNER, turn on BURNER.
</Text>
      <RtfText>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green128\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs17 If AUTO_BURNER_CMD and conditions are met for BURNER, turn on BURNER.\par
\par
}
